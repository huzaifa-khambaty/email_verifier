APP_NAME=NextMatchMail
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Production targets MariaDB (v2 §2); SQLite is fine for local dev.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=email_verifier
# DB_USERNAME=verifier
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,nextmatchmail.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Email verification engine (see DECISIONS.md) -------------------------
SMTP_HELO_DOMAIN=verify.nextmatchmail.com
SMTP_MAIL_FROM=verify@nextmatchmail.com
SMTP_CONNECT_TIMEOUT=10
SMTP_READ_TIMEOUT=10
SMTP_PORT=25
SMTP_CATCH_ALL_CHECK=true

VERIFY_DEFAULT_DELAY_SECONDS=3
VERIFY_MAJOR_PROVIDER_DELAY_SECONDS=8
VERIFY_DEFAULT_MAX_WORKERS=1
VERIFY_MAX_ATTEMPTS=5
VERIFY_CIRCUIT_BREAKER_THRESHOLD=5
VERIFY_CIRCUIT_BREAKER_COOLDOWN_MINUTES=30
VERIFY_CLAIM_BATCH_SIZE=10

# Seeded by `php artisan db:seed` — the one admin account (no public
# registration, see DECISIONS.md).
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@nextmatchmail.com
ADMIN_PASSWORD=change-me
