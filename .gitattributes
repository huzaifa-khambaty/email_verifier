# Force LF regardless of the checkout platform's core.autocrlf — critical
# for deploy/remote-deploy.sh specifically, which must run as bash on the
# Ubuntu VPS/GitHub Actions runner; a CRLF shebang line breaks it outright
# ("bad interpreter" / stray $'\r' errors).
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
